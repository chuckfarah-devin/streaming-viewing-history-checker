# Android build outputs
build/
app/build/
*/build/

# Gradle
.gradle/
local.properties

# Android Studio / IntelliJ IDEA
*.iml
.idea/
*.idea/

# Keystore files — never commit signing keys
*.jks
*.keystore

# API keys and secrets — never commit
google-services.json
secrets.properties

# Generated files
gen/
generated/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Release APKs and bundles
app/release/
*.apk
*.aab

# ── Personal Netflix viewing data — NEVER commit ──────────────────────────────
# Real Netflix exports (any filename variants)
NetflixViewingHistory*.csv
ViewingActivity*.csv
**/local-test-data/
**/private-test-data/

# Gradle wrapper binary (cannot be committed as text; generate with: gradle wrapper)
gradle/wrapper/gradle-wrapper.jar
